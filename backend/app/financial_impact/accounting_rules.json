          "source_verification": "official_locator_checked",
          "checked_at": "2026-10-23",
          "reviewer": "automated_source_check"
        }
      ],
      "verification": "pending_human_review",
      "cash_flow_class": "经营活动（费用化部分）；资本化部分不形成当期现金流出分类变化"
    },
    {
      "rule_id": "AR-06",
