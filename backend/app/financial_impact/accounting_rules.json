{
  "version": "accounting_rules_v1.1",
  "notice": "12条候选路径已有官方位置索引；专业人工复核仍待完成。确认条件与企业事实逐项分开，准则版本按报告期间和采用政策判断。",
  "rules": [
    {
      "rule_id": "AR-01",
      "scene": "环保设施购建（资本性支出）",
      "activity_types": [
        "facility_retrofit",
        "green_equipment"
      ],
      "applies_when": [
        "项目已立项并实际发生建造或购置支出",
        "该设施用于生产经营且预计使用超过一个会计年度",
        "与该资产有关的经济利益很可能流入企业",
        "成本能够可靠计量"
      ],
      "accounts": [
        "在建工程",
        "固定资产",
        "银行存款",
        "应付账款"
      ],
      "recognition": [
        "建造期间先在在建工程归集",
        "达到预定可使用状态时转入固定资产并计提折旧",
        "未达到确认条件的前期支出不得挂账为资产"
      ],
      "required_evidence": [
        "项目立项或合同",
        "在建工程/固定资产附注的项目级明细",
        "转固时点与验收文件",
        "本期增加额与现金支付额"
      ],
      "counter_examples": [
        "只有预算数没有实际支出",
        "支出属于日常维护且不提升产能或延长寿命",
        "项目已停建且无经济利益流入"
      ],
      "basis": [
        {
          "title": "企业会计准则第4号——固定资产",
          "issuer": "财政部",
          "version": "2006年发布",
          "locator": "第二章第三、四条；第三章第七至九条",
          "note": "已核对官方来源位置；不等于会计专家人工复核，也不证明企业满足确认条件",
          "source_url": "https://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080519_23104.htm",
          "source_verification": "official_locator_checked",
          "checked_at": "2026-10-23",
          "reviewer": "automated_source_check"
        }
      ],
      "verification": "pending_human_review",
      "cash_flow_class": "投资活动——购建固定资产、无形资产和其他长期资产支付的现金"
    },
    {
      "rule_id": "AR-02",
      "scene": "在建工程转固",
      "activity_types": [
        "facility_retrofit",
        "efficiency_retrofit"
      ],
      "applies_when": [
        "工程已达到预定可使用状态",
        "转固金额有附注本期减少/转入固定资产列支持",
        "转固后开始计提折旧"
      ],
      "accounts": [
        "在建工程",
        "固定资产",
        "累计折旧"
      ],
      "recognition": [
        "达到预定可使用状态即转固，不以竣工决算为唯一条件"
      ],
      "required_evidence": [
        "在建工程附注的本期转入固定资产列",
        "固定资产附注的本期增加列",
        "验收或投产公告"
      ],
      "counter_examples": [
        "仅列示期末余额，没有本期增加与转出",
        "工程仍处于调试阶段"
      ],
      "basis": [
        {
          "title": "企业会计准则第4号——固定资产",
          "issuer": "财政部",
          "version": "2006年发布",
          "locator": "第九条、第十四至十八条；转固时点仍需企业会计政策和原文证据",
          "note": "已核对官方来源位置；不等于会计专家人工复核，也不证明企业满足确认条件",
          "source_url": "https://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080519_23104.htm",
          "source_verification": "official_locator_checked",
          "checked_at": "2026-10-23",
          "reviewer": "automated_source_check"
        }
      ],
      "verification": "pending_human_review",
      "cash_flow_class": "不影响当期现金流（非现金结转）"
    },
    {
      "rule_id": "AR-03",
      "scene": "固定资产后续支出：资本化与费用化区分",
      "activity_types": [
        "efficiency_retrofit",
        "facility_retrofit"
      ],
      "applies_when": [
        "符合固定资产第四条的经济利益很可能流入和成本可靠计量条件",
        "不符合确认条件的后续支出于发生时计入当期损益"
      ],
      "accounts": [
        "固定资产",
        "管理费用",
        "制造费用",
        "银行存款"
      ],
      "recognition": [
        "符合资本化条件的计入固定资产成本",
        "日常修理维护计入当期费用"
      ],
      "required_evidence": [
        "支出性质说明",
        "改造前后产能或能耗对比",
        "费用明细账或附注"
      ],
      "counter_examples": [
        "把日常维护费用计入在建工程",
        "把设备更新支出全部费用化"
      ],
      "basis": [
        {
          "title": "企业会计准则第4号——固定资产",
          "issuer": "财政部",
          "version": "2006年发布",
          "locator": "第六条、第二十四条",
          "note": "已核对官方来源位置；不等于会计专家人工复核，也不证明企业满足确认条件",
          "source_url": "https://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080519_23104.htm",
          "source_verification": "official_locator_checked",
          "checked_at": "2026-10-23",
          "reviewer": "automated_source_check"
        }
      ],
      "verification": "pending_human_review",
      "cash_flow_class": "资本化部分属投资活动；费用化部分属经营活动"
    },
    {
      "rule_id": "AR-04",
      "scene": "日常污染治理与环保运行费用",
      "activity_types": [
        "pollution_treatment"
      ],
      "applies_when": [
        "支出不形成长期资产",
        "属于维持合规运行的经常性支出"
      ],
      "accounts": [
        "管理费用",
        "制造费用",
        "营业成本"
      ],
      "recognition": [
        "按受益对象计入当期费用或生产成本"
      ],
      "required_evidence": [
        "费用明细或附注",
        "治理设施运行记录",
        "与环境支出相关的现金流"
      ],
      "counter_examples": [
        "把治理设施建造支出直接费用化",
        "把费用性支出挂账为在建工程"
      ],
      "basis": [
        {
          "title": "企业会计准则第1号——存货",
          "issuer": "财政部",
          "version": "2006年发布",
          "locator": "第五至九条；仅在确属存货成本时适用",
          "note": "已核对官方来源位置；不等于会计专家人工复核，也不证明企业满足确认条件",
          "source_url": "https://www.mof.gov.cn/zhengwuxinxi/zhengcefabu/2006zcfb/200805/t20080519_23107.htm",
