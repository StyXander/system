          "checked_at": "2026-10-23",
          "reviewer": "automated_source_check"
        }
      ],
      "verification": "pending_human_review",
      "cash_flow_class": "经营活动"
    },
    {
      "rule_id": "AR-05",
      "scene": "研究阶段与开发阶段支出",
      "activity_types": [
        "green_rnd"
      ],
      "applies_when": [
        "研究阶段支出全部费用化",
        "开发阶段须同时满足技术可行性、使用或出售意图、经济利益可能性、资源支持与支出可可靠计量"
      ],
      "accounts": [
        "研发费用",
        "开发支出",
        "无形资产"
      ],
      "recognition": [
        "不满足资本化条件的开发支出计入当期损益",
        "满足条件的转入无形资产"
      ],
      "required_evidence": [
        "研发费用附注",
        "开发支出附注的本期增加与转出",
        "资本化政策与项目进度"
      ],
      "counter_examples": [
        "把研发投入总额直接等同于研发费用",
        "把政府补助金额当作研发支出"
      ],
      "basis": [
        {
