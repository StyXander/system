{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./data-schema.json",
  "title": "审迹智链第二周本地状态 Schema",
  "description": "对应 app.js 保存在浏览器中的 W2 开发预览数据。允许字段暂时为空；页面运行时执行计算、T0 日期、evidence_id 与来源完整度门槛。R1 当前只做增速差方向筛查，不设置风险等级或幅度阈值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "dataContext", "data", "review"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyName",
        "analysisDate",
        "scene",
        "industry",
        "currentYear",
        "previousYear",
        "amountUnit"
      ],
      "properties": {
        "companyName": { "type": "string" },
        "analysisDate": {
          "type": "string",
          "description": "空白或 YYYY-MM-DD；页面会阻断披露日晚于该 T0 的来源。"
        },
        "scene": {
          "type": "string",
          "enum": ["新客户业务承接", "续聘复核", "审计计划"]
        },
        "industry": { "type": "string" },
        "currentYear": { "type": "string" },
        "previousYear": { "type": "string" },
        "amountUnit": {
          "type": "string",
          "enum": ["元", "万元", "百万元"],
          "description": "页面切换金额单位时，会对已录入的四项金额进行等值换算，保持实际金额及增长率不变。默认与年报一致使用「元」。"
        }
      }
    },
    "dataContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companyName", "currentYear", "previousYear", "origin"],
      "description": "四项数字实际绑定的公司和连续年度。与 project 不一致时页面必须停止计算。",
      "properties": {
        "companyName": { "type": "string" },
        "currentYear": { "type": "string" },
        "previousYear": { "type": "string" },
        "origin": { "type": "string", "enum": ["manual", "week1_sample"] }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revenue_current",
        "revenue_previous",
        "ar_current",
        "ar_previous"
      ],
      "properties": {
        "revenue_current": { "$ref": "#/$defs/evidenceRow" },
        "revenue_previous": { "$ref": "#/$defs/evidenceRow" },
        "ar_current": { "$ref": "#/$defs/evidenceRow" },
        "ar_previous": { "$ref": "#/$defs/evidenceRow" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["未复核", "保留为待核查候选", "降级", "暂缓"]
        },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "evidenceId",
        "sourceFile",
        "disclosureDate",
        "pdfPage",
        "printPage",
        "locator"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "金额的原始录入文本；正式计算前由程序转换并检查。"
        },
        "evidenceId": {
          "type": "string",
          "description": "统一来源编号，如 STD_REV_2025；参与计算的每个数字必须有唯一编号。"
        },
        "sourceFile": { "type": "string" },
        "disclosureDate": { "type": "string" },
        "pdfPage": { "type": "string" },
        "printPage": {
          "type": "string",
          "description": "原件无印刷页码时填写‘原件未标注’，不得猜测。"
        },
        "locator": {
          "type": "string",
          "description": "原文、表名或可返回正式披露原件的具体位置。"
        }
      }
    }
  }
}
