{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./data-schema.json",
  "title": "审迹智链第一周本地状态 Schema",
  "description": "对应 prototype/app.js 中保存到浏览器的 M0 开发预览数据。允许字段暂时为空；页面运行时再执行计算与来源完整度门槛。本文件不包含尚未由 A 确认的 R1 提醒阈值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "data", "review"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "companyName",
        "analysisDate",
        "scene",
        "industry",
        "currentYear",
        "previousYear",
        "amountUnit"
      ],
      "properties": {
        "companyName": { "type": "string" },
        "analysisDate": {
          "type": "string",
          "description": "空白或 YYYY-MM-DD；正式接入时须由程序执行日期白名单校验。"
        },
        "scene": {
          "type": "string",
          "enum": ["新客户业务承接", "续聘复核", "审计计划"]
        },
        "industry": { "type": "string" },
        "currentYear": { "type": "string" },
        "previousYear": { "type": "string" },
        "amountUnit": {
          "type": "string",
          "enum": ["元", "万元", "百万元"]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revenue_current",
        "revenue_previous",
        "ar_current",
        "ar_previous"
      ],
      "properties": {
        "revenue_current": { "$ref": "#/$defs/evidenceRow" },
        "revenue_previous": { "$ref": "#/$defs/evidenceRow" },
        "ar_current": { "$ref": "#/$defs/evidenceRow" },
        "ar_previous": { "$ref": "#/$defs/evidenceRow" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["未复核", "保留为待核查候选", "降级", "暂缓"]
        },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "evidenceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "sourceFile",
        "disclosureDate",
        "pdfPage",
        "printPage",
        "locator"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "金额的原始录入文本；正式计算前由程序转换并检查。"
        },
        "sourceFile": { "type": "string" },
        "disclosureDate": { "type": "string" },
        "pdfPage": { "type": "string" },
        "printPage": {
          "type": "string",
          "description": "原件无印刷页码时明确填写‘原件未标注’，不得猜测。"
        },
        "locator": {
          "type": "string",
          "description": "原文、表名或可返回原件的具体位置。"
        }
      }
    }
  }
}
