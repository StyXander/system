# 复制为 .env 后再填写；不要把真实Key发到聊天、放进网页或提交到仓库。
# 旧 Key 若曾在聊天中暴露，请先在 OpenCode 控制台撤销并换新 Key，只由用户本人写入本机 .env。
DEEPSEEK_API_KEY=
# 供应商开放接口基础地址（不含 /chat/completions，程序会自行拼接）。
# OpenCode Go：https://opencode.ai/zen/go/v1 ；原生 DeepSeek：https://api.deepseek.com
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=qwen3.5-plus
# 单角色供应商等待窗口；只影响网络等待，不放宽任何模型输出硬校验。
AUDITTRACE_PROVIDER_TIMEOUT_SECONDS=120
AUDITTRACE_PUBLIC_DEMO=false
AUDITTRACE_DEMO_MODE=true
# 是否允许本次运行调用真实外部模型；默认开启，设为 false 可强制使用确定性备用。
AUDITTRACE_DEMO_USE_EXTERNAL_MODEL=true
# 无 Token 消耗的供应商只读探测（/models 等）；有 TTL 与并发锁，不会每次刷新重复请求。
AUDITTRACE_PROVIDER_PROBE_ENABLED=true
# 仅团队本机评审现场开启；允许搜索、下载并解析非内置企业的巨潮公开年报。
AUDITTRACE_ONSITE_LIVE_SAMPLE=false
# 默认同源；只有前后端分离时才填写逗号分隔的明确 Origin。
AUDITTRACE_CORS_ORIGINS=
# 仅在已知反向代理网段下使用 X-Forwarded-For；两项必须同时配置。
AUDITTRACE_TRUSTED_PROXY_HOPS=0
AUDITTRACE_TRUSTED_PROXY_CIDRS=
# 公网真实模型和批量预热要求至少 32 位的服务端随机秘密。
AUDITTRACE_PUBLIC_QUOTA_SECRET=
# 竞赛数据截止日（比赛公告日）；未确认前留空，知识库按草案处理，不声称完整。
COMPETITION_DATA_CUTOFF_DATE=
# 知识库快照 ID（例如 KNOWLEDGE-20260824-V1）；确认截止日后填写。
KNOWLEDGE_SNAPSHOT_ID=
