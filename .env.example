# 复制为 .env 后再填写；不要把真实Key发到聊天、放进网页或提交到仓库。
DEEPSEEK_API_KEY=
# OpenCode Go 的 OpenAI-compatible endpoint；使用原生 DeepSeek 时改为 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
DEEPSEEK_MODEL=deepseek-v4-flash
AUDITTRACE_PUBLIC_DEMO=false
AUDITTRACE_DEMO_MODE=true
AUDITTRACE_DEMO_USE_EXTERNAL_MODEL=false
# 默认同源；只有前后端分离时才填写逗号分隔的明确 Origin。
AUDITTRACE_CORS_ORIGINS=
# 仅在已知反向代理网段下使用 X-Forwarded-For；两项必须同时配置。
AUDITTRACE_TRUSTED_PROXY_HOPS=0
AUDITTRACE_TRUSTED_PROXY_CIDRS=
# 公网真实模型和批量预热要求至少 32 位的服务端随机秘密。
AUDITTRACE_PUBLIC_QUOTA_SECRET=
