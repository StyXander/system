# ========================================================
# 审迹智链 (AuditTrace) 环境配置示例
# 复制本文件为 .env 后再按需配置；请勿提交含真实密钥的 .env 文件到代码仓库
# ========================================================

# [大模型配置] (支持 DeepSeek / OpenAI / 通义千问 / 智谱 / vLLM / Ollama 等兼容 OpenAI 格式的服务)
# 默认使用 DeepSeek 官方接口
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 若使用其他兼容 OpenAI 格式的模型或本地部署（如 vLLM / Ollama），填入对应配置并将 AUDITTRACE_ALLOW_ANY_PROVIDER 设为 true
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
AUDITTRACE_ALLOW_ANY_PROVIDER=false

# [运行与演示模式]
# 免登录单用户演示模式（关闭每日Token/频次限制，适合评审与本地演示）
AUDITTRACE_SINGLE_USER=true
# 是否允许调用外部真实大模型；设为 false 时使用本地规则和离线分析
AUDITTRACE_DEMO_USE_EXTERNAL_MODEL=true
# 任务存储模式：local（本地轻量存储）或 supabase（云端持久化）
AUDITTRACE_DEMO_TASK_PERSISTENCE=local
AUDITTRACE_DEMO_MODE=true

# [云端持久化配置（可选）]
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [超时与安全性]
AUDITTRACE_PROVIDER_TIMEOUT_SECONDS=120
CONNECTIVITY_MATTER_ENABLED=true

# [高级选项]
# 扫描页 OCR：默认关闭；若需启用请在系统安装 Tesseract 及 chi_sim 语言包
CONNECTIVITY_MATTER_OCR=false
# 本地向量检索模型路径（留空时默认使用高效词法检索 + 别名扩展）
CONNECTIVITY_MATTER_EMBEDDING_MODEL=
